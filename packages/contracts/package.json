{
  "name": "@sports-predict/contracts",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "forge build 2>/dev/null || npx solcjs --bin --abi --include-path node_modules --base-path . src/*.sol -o out/",
    "test": "npx hardhat test",
    "deploy:local": "npx hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "npx hardhat run scripts/deploy.ts --network base_sepolia",
    "clean": "rm -rf out cache"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.4.0",
    "hardhat": "^2.28.4",
    "solc": "^0.8.33"
  }
}
