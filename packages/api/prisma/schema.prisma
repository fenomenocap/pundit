generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum MarketStatus {
  OPEN
  LOCKED
  RESOLVED
  CANCELLED
}

// Sport/competition-based categories (aligned with frontend UI)
enum MarketCategory {
  WORLD_CUP
  CHAMPIONS_LEAGUE
  EUROPA_LEAGUE
  PREMIER_LEAGUE
  LA_LIGA
  BUNDESLIGA
  SERIE_A
  LIGUE_1
  OTHER
}

// ─── Models ─────────────────────────────────────────────────────────────────

/// Mirrors on-chain market data with additional off-chain metadata.
model Market {
  id                  String         @id @default(uuid())
  onchainId           Int            @unique
  question            String
  outcomeA            String         // e.g. "Yes" / "Brazil"
  outcomeB            String         // e.g. "No"  / "Germany"
  outcomeC            String?        // e.g. "Draw" — null for binary markets
  category            MarketCategory
  teamA               String?
  teamB               String?
  polymarketId        String?        // Polymarket conditionId for reference odds
  poolYes             BigInt         @default(0)
  poolNo              BigInt         @default(0)
  poolDraw            BigInt         @default(0)  // net shares on outcome 2
  totalVolume         BigInt         @default(0)  // gross USDC traded (for accurate sorting)
  status              MarketStatus   @default(OPEN)
  resolvedOutcome     Int?           // 0, 1, or 2; null if unresolved
  resolvedAt          DateTime?
  resolutionTimestamp DateTime
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  trades    Trade[]
  positions Position[]

  @@index([status])
  @@index([category])
}

/// Individual share purchase event, indexed from on-chain.
model Trade {
  id          String   @id @default(uuid())
  marketId    String
  market      Market   @relation(fields: [marketId], references: [id])
  userAddress String
  outcome     Int      // 0, 1, or 2
  grossAmount BigInt   // USDC deposited by user (6 decimals, before fee)
  netShares   BigInt   // shares received (after fee)
  txHash      String   @unique
  blockNumber Int
  timestamp   DateTime

  @@index([marketId])
  @@index([userAddress])
  @@index([blockNumber])
}

/// Aggregated user position per market per outcome.
model Position {
  id          String  @id @default(uuid())
  marketId    String
  market      Market  @relation(fields: [marketId], references: [id])
  userAddress String
  outcome     Int     // 0, 1, or 2
  shares      BigInt  @default(0)  // net shares
  claimed     Boolean @default(false)

  @@unique([marketId, userAddress, outcome])
  @@index([userAddress])
}

/// Singleton row tracking the last block the indexer has processed.
model IndexerState {
  id               Int @id @default(1)
  lastIndexedBlock Int @default(0)
}
