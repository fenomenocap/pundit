{
  "name": "@sports-predict/api",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm verify:club-strength-artifact && tsc",
    "test": "vitest run",
    "build:wc-evaluation": "npx ts-node --transpile-only scripts/build-wc2026-evaluation.ts",
    "build:club-history": "ts-node --transpile-only scripts/build-club-history-corpus.ts",
    "build:club-strength-artifact": "ts-node --transpile-only scripts/build-club-strength-artifact.ts",
    "capture:clubelo-snapshot": "ts-node --transpile-only scripts/capture-clubelo-snapshot.ts",
    "capture:clubelo-history": "ts-node --transpile-only scripts/capture-clubelo-history.ts",
    "check:club-strength-freshness": "ts-node --transpile-only scripts/check-club-strength-freshness.ts",
    "refresh:clubelo-snapshot": "ts-node --transpile-only scripts/refresh-clubelo-snapshot.ts",
    "build:clubelo-pre-kickoff": "ts-node --transpile-only scripts/build-clubelo-pre-kickoff-corpus.ts",
    "train:dixon-coles-mle": "ts-node --transpile-only scripts/train-dixon-coles-mle.ts",
    "register:dixon-coles-mle": "ts-node --transpile-only scripts/register-dixon-coles-mle.ts",
    "eval:dixon-coles-mle": "ts-node --transpile-only scripts/eval-dixon-coles-mle.ts",
    "calibrate:champion": "ts-node --transpile-only scripts/calibrate-champion.ts",
    "rebuild:club-strength-golden": "ts-node --transpile-only scripts/rebuild-club-strength-golden.ts",
    "verify:club-strength-artifact": "ts-node --transpile-only scripts/verify-club-strength-artifact.ts",
    "backup:club-season-ledger": "ts-node --transpile-only scripts/backup-club-season-ledger.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "tsx": "4.23.15",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11",
    "vite": "^8.0.0"
  }
}
