{
  "name": "pundit",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @sports-predict/api build && pnpm --filter @sports-predict/web build",
    "test": "pnpm -r test",
    "chat-eval:dry-run": "node scripts/chat-battle-test.mjs --dry-run",
    "chat-eval:test": "node --test scripts/chat-battle-test.test.mjs scripts/capture-chat-eval-browser.test.mjs scripts/render-chat-transcript.test.mjs",
    "chat-eval:production": "node scripts/chat-battle-test.mjs",
    "chat-eval:browser": "node scripts/capture-chat-eval-browser.mjs",
    "chat-eval:finalize": "node scripts/finalize-chat-report.mjs",
    "test:braces-security": "node --test scripts/braces-security.test.mjs",
    "test:vercel-ignore": "node --test scripts/vercel-ignore-build.test.mjs",
    "test:deployed-sha": "node --test scripts/resolve-deployed-sha.test.mjs",
    "test:verify-prod": "node --test scripts/verify-prod.test.mjs",
    "test:wait-railway-deploy": "node --test scripts/wait-for-railway-deploy.test.mjs",
    "clean": "pnpm -r clean",
    "verify:prod": "bash scripts/verify-prod.sh",
    "verify:local": "bash scripts/verify-local.sh",
    "test:dependency-security": "node --test scripts/braces-security.test.mjs scripts/dependency-security.test.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "next": "15.5.27"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "8.5.28",
      "brace-expansion@<2": "1.1.21",
      "brace-expansion@>=2 <3": "2.1.7",
      "minimatch@>=3 <4": "3.1.4",
      "minimatch@>=9 <10": "9.0.7",
      "picomatch@>=2 <3": "2.3.2",
      "js-yaml@>=4 <4.3.2": "4.3.2",
      "flatted@<3.4.2": "3.4.2",
      "ajv@>=6 <6.14.0": "6.14.0",
      "nanoid@>=3 <3.3.18": "3.3.18",
      "tsx@<4.23.15": "4.23.15",
      "braces": "file:vendor/brace-patterns",
      "postcss-selector-parser@<7.1.6": "7.1.6",
      "source-map-js@<1.2.2": "1.2.2",
      "proxy-addr@<2.0.8": "2.0.8"
    }
  }
}
