{
  "schemaVersion": 9,
  "fixed": [
    {
      "id": "active-match-grounding",
      "description": "A model-backed active club fixture receives match grounding.",
      "kind": "featured"
    },
    {
      "id": "priced-fixture-retains-1x2-context",
      "description": "An explicit 1X2 follow-up cannot lose or replace the exact priced fixture.",
      "kind": "featured-turns",
      "turns": [
        {
          "questionTemplate": "Analyse {home} vs {away}.",
          "expectGrounding": "match"
        },
        {
          "question": "What will the 1X2 be?",
          "expectGrounding": "match"
        }
      ]
    },
    {
      "id": "table-route-preserves-match",
      "description": "A table detour routes as competition grounding without deleting the retained fixture.",
      "kind": "featured-turns",
      "turns": [
        {
          "questionTemplate": "Analyse {home} vs {away}.",
          "expectGrounding": "match"
        },
        {
          "question": "What does the current Premier League table show?",
          "expectGrounding": "competition",
          "expectCompetitionId": "eng.1"
        },
        {
          "question": "Back to that match: what will the 1X2 be?",
          "expectGrounding": "match"
        }
      ]
    },
    {
      "id": "replacing-is-not-epl",
      "description": "The token epl inside replacing never creates competition grounding.",
      "kind": "json",
      "turns": [
        {
          "question": "Who is replacing the injured manager?",
          "expectGrounding": null,
          "requireCitation": true
        }
      ]
    },
    {
      "id": "candidate-never-becomes-fixture",
      "description": "A search-shaped, non-authoritative matchup candidate receives no fixture badge or Pundit probabilities.",
      "kind": "json",
      "turns": [
        {
          "question": "What are Pundit's probabilities for Northbridge Athletic vs Southbank Rovers tomorrow?",
          "expectGrounding": null,
          "expectNoPunditProbabilities": true,
          "expectNoScorelines": true,
          "expectEvidenceAbstention": true
        }
      ]
    },
    {
      "id": "recognized-friendly-outside-coverage",
      "description": "An exact authoritative friendly must be fixture-grounded, context-retaining and unable to emit Pundit probabilities.",
      "kind": "recognized",
      "capabilityStatus": "outside-coverage",
      "capabilityReason": "friendly-policy-disabled",
      "competitionCategory": "club-friendly",
      "requiredForCertification": false,
      "turns": [
        { "questionTemplate": "What are Pundit's probabilities for {home} vs {away}?" },
        { "questionTemplate": "What about that fixture's 1X2?" }
      ]
    },
    {
      "id": "temporary-fixture-unavailability",
      "description": "A recognized eligible fixture in model initialization or ratings refresh reports a temporary capability.",
      "kind": "recognized",
      "capabilityStatus": "temporarily-unpriced",
      "requiredForCertification": false,
      "turns": [
        { "questionTemplate": "Analyse {home} vs {away}." }
      ]
    },
    {
      "id": "unsupported-followup-and-matchup-replacement",
      "description": "An unsupported fixture survives follow-ups until a new exact recognized matchup replaces it.",
      "kind": "recognized-replacement",
      "requiredForCertification": false
    },
    {
      "id": "complete-market-arithmetic",
      "description": "A complete same-source/time decimal 1X2 market uses 1/odds and normalizes to 100 percent.",
      "kind": "runtime-helper",
      "helper": "validateCompleteOneXTwoMarket",
      "args": [[
        { "outcome": "home", "decimalOdds": 2, "source": "Example Book", "observedAt": "2026-08-13T10:00:00Z" },
        { "outcome": "draw", "decimalOdds": 4, "source": "Example Book", "observedAt": "2026-08-13T10:00:00Z" },
        { "outcome": "away", "decimalOdds": 4, "source": "Example Book", "observedAt": "2026-08-13T10:00:00Z" }
      ]],
      "expect": { "valid": true },
      "expectText": ["noVigProbabilities", "overround"]
    },
    {
      "id": "incomplete-market-fails-closed",
      "description": "A missing 1X2 leg is never guessed or normalized.",
      "kind": "runtime-helper",
      "helper": "validateCompleteOneXTwoMarket",
      "args": [[
        { "outcome": "home", "decimalOdds": 2, "source": "Example Book", "observedAt": "2026-08-13T10:00:00Z" },
        { "outcome": "away", "decimalOdds": 4, "source": "Example Book", "observedAt": "2026-08-13T10:00:00Z" }
      ]],
      "expect": { "valid": false, "reason": "missing-leg" }
    },
    {
      "id": "third-party-probability-labelling",
      "description": "External probabilities are explicitly labelled as third-party and not Pundit output.",
      "kind": "runtime-helper",
      "helper": "probabilityAttribution",
      "args": [{ "kind": "external-market", "source": "Example Book", "observedAt": "2026-08-13T10:00:00Z" }],
      "expect": { "valid": true },
      "expectText": ["Example Book", "not a Pundit forecast"]
    },
    {
      "id": "neutral-venue-missing-input",
      "description": "A recognized neutral-site fixture remains unpriced when required venue context is unavailable.",
      "kind": "recognized",
      "capabilityStatus": "insufficient-model-input",
      "capabilityReason": "neutral-venue-unknown",
      "requiredForCertification": false,
      "turns": [
        { "questionTemplate": "What is the forecast for {home} vs {away}?" }
      ]
    },
    {
      "id": "friendly-capability-runtime-contract",
      "description": "The built API capability policy classifies an injected authoritative club friendly outside coverage.",
      "kind": "runtime-helper",
      "helper": "evaluateFixtureCapability",
      "args": [
        {"fixtureId":"official:friendly:1","primarySource":"official-club","primarySourceFixtureId":"1","homeTeam":{"id":"a","name":"Alpha"},"awayTeam":{"id":"b","name":"Beta"},"kickoff":"2026-08-14T10:00:00Z","venue":"Training Ground","neutralVenue":false,"competition":{"id":"club-friendly","name":"Club Friendly","category":"club-friendly"},"status":"scheduled","recognition":"authoritative","observedSources":[{"source":"official-club","sourceFixtureId":"1","authority":"authoritative","observedAt":"2026-08-13T10:00:00Z"}],"observationHistory":[{"source":"official-club","sourceFixtureId":"1","observedAt":"2026-08-13T10:00:00Z","kickoff":"2026-08-14T10:00:00Z","venue":"Training Ground","neutralVenue":false,"status":"scheduled"}]},
        {"modelInitialized":true,"ratingsAvailable":true}
      ],
      "expect":{"status":"outside-coverage","reason":"friendly-policy-disabled"}
    },
    {
      "id": "neutral-venue-capability-fault-contract",
      "description": "Evaluator boundary fault injection: a recognized neutral-site fixture with unknown venue state retains the exact insufficient-input capability and emits no model fields.",
      "kind": "deterministic",
      "validator": "fixture-grounding",
      "input": {
        "kind":"fixture",
        "fixture":{"fixtureId":"official:neutral:1","primarySource":"official-federation","primarySourceFixtureId":"1","homeTeam":{"id":"a","name":"Alpha"},"awayTeam":{"id":"b","name":"Beta"},"kickoff":"2026-08-14T10:00:00Z","venue":null,"neutralVenue":null,"competition":{"id":"international-qualifier","name":"Qualifier","category":"international-qualifier"},"status":"scheduled","recognition":"authoritative","observedSources":[{"source":"official-federation","sourceFixtureId":"1","authority":"authoritative","observedAt":"2026-08-13T10:00:00Z"}],"observationHistory":[{"source":"official-federation","sourceFixtureId":"1","observedAt":"2026-08-13T10:00:00Z","kickoff":"2026-08-14T10:00:00Z","venue":null,"neutralVenue":null,"status":"scheduled"}]},
        "capability":{"status":"insufficient-model-input","reason":"neutral-venue-unknown"}
      },
      "expectation":{"expectFixtureId":"official:neutral:1","expectCapability":{"status":"insufficient-model-input","reason":"neutral-venue-unknown"},"expectCompetitionCategory":"international-qualifier"}
    },
    {
      "id": "temporary-capability-runtime-contract",
      "description": "The built API capability policy classifies an injected eligible fixture as temporarily unpriced during initialization.",
      "kind": "runtime-helper",
      "helper": "evaluateFixtureCapability",
      "args": [
        {"fixtureId":"espn:eng.1:1","primarySource":"espn","primarySourceFixtureId":"1","homeTeam":{"id":"a","name":"Alpha"},"awayTeam":{"id":"b","name":"Beta"},"kickoff":"2026-08-14T10:00:00Z","venue":"Stadium","neutralVenue":false,"competition":{"id":"eng.1","name":"Premier League","category":"domestic-league"},"status":"scheduled","recognition":"authoritative","observedSources":[{"source":"espn","sourceFixtureId":"1","authority":"authoritative","observedAt":"2026-08-13T10:00:00Z"}],"observationHistory":[{"source":"espn","sourceFixtureId":"1","observedAt":"2026-08-13T10:00:00Z","kickoff":"2026-08-14T10:00:00Z","venue":"Stadium","neutralVenue":false,"status":"scheduled"}]},
        {"modelInitialized":false,"ratingsAvailable":true}
      ],
      "expect":{"status":"temporarily-unpriced","reason":"model-initializing"}
    },
    {
      "id": "stale-manager-official-conflict",
      "description": "Runtime utility contract: dated manager eras detect a stale asserted manager conflict. End-to-end /api/ask behavior requires critic review.",
      "kind": "runtime-helper",
      "helper": "attributeManagerEra",
      "args": [
        "2026-04-10T12:00:00Z",
        [
          { "manager": "Old Manager", "startedAt": "2025-01-01", "endedAt": "2026-05-31" },
          { "manager": "New Manager", "startedAt": "2026-06-01" }
        ],
        "New Manager"
      ],
      "expect": { "status": "conflict", "manager": "Old Manager", "assertedManager": "New Manager" }
    },
    {
      "id": "correction-after-wrong-history",
      "description": "Runtime utility contract: correction language is detected so the service can force re-verification. This helper alone does not certify acknowledgement text.",
      "kind": "runtime-helper",
      "helper": "containsCorrectionCue",
      "args": ["Actually, that's the wrong manager. Re-check it against current evidence."],
      "expect": {},
      "expectText": ["true"]
    },
    {
      "id": "one-one-is-not-over-two-five",
      "description": "Runtime utility contract: the built scoreline settlement path grades 1-1 over 2.5 as a loss.",
      "kind": "runtime-helper",
      "helper": "settleScorelineTotal",
      "args": ["1-1", 2.5, "over"],
      "expect": {},
      "expectText": ["lose"]
    },
    {
      "id": "unrelated-citation-rejected",
      "description": "Runtime utility contract: an unsupported claim is removed rather than retained with unrelated evidence.",
      "kind": "runtime-helper",
      "helper": "applyClaimDecisions",
      "args": [
        [{ "id": "C1", "text": "Unsupported current claim." }],
        [{ "claimId": "C1", "outcome": "unsupported", "evidenceIds": [] }]
      ],
      "expect": { "supported": [], "removedClaimIds": ["C1"], "conflictClaimIds": [] },
      "expectText": ["could not establish"]
    },
    {
      "id": "degraded-search-retrieval-verifier",
      "description": "Runtime utility contract: a verifier conflict removes the claim and emits a conflict abstention. Provider degradation remains a live probe.",
      "kind": "runtime-helper",
      "helper": "applyClaimDecisions",
      "args": [
        [{ "id": "C1", "text": "Conflicted current claim." }],
        [{ "claimId": "C1", "outcome": "conflict", "evidenceIds": ["S1", "S2"] }]
      ],
      "expect": { "supported": [], "removedClaimIds": ["C1"], "conflictClaimIds": ["C1"] },
      "expectText": ["sources conflict"]
    },
    {
      "id": "team-news-sourcing",
      "description": "A team-news question either cites a source and date or states plainly that no verified update was established.",
      "kind": "featured-question",
      "questionTemplate": "Any injury or lineup news for {home} vs {away}?",
      "requireSourcedTeamNews": true,
      "requireCitation": true,
      "allowAbstention": true
    },
    {
      "id": "market-comparison-coverage",
      "description": "A market-comparison question keeps its grounded scoreline payload; the odds-source count is reported so a missing market line is visible rather than silent.",
      "kind": "featured-question",
      "questionTemplate": "How do the market prices for {home} vs {away} compare with the model?"
    },
    {
      "id": "competition-grounding",
      "description": "A Premier League table question receives ESPN standings grounding.",
      "kind": "json",
      "turns": [
        {
          "question": "What does the current Premier League table show?",
          "expectGrounding": "competition",
          "expectCompetitionId": "eng.1"
        }
      ]
    },
    {
      "id": "competition-follow-up",
      "description": "A referential follow-up remains grounded in the Premier League standings.",
      "kind": "json",
      "turns": [
        {
          "question": "Who is leading the Premier League title race?",
          "expectGrounding": "season",
          "expectCompetitionId": "eng.1"
        },
        {
          "question": "What is the strongest caveat to that table-based ranking?",
          "expectGrounding": "competition",
          "expectCompetitionId": "eng.1"
        }
      ]
    },
    {
      "id": "general-analysis-label",
      "description": "A general football question remains explicitly ungrounded at the API boundary.",
      "kind": "json",
      "turns": [
        {
          "question": "How does a high defensive line change a team's pressing risks?",
          "expectGrounding": null
        }
      ]
    },
    {
      "id": "contextual-follow-up",
      "description": "A pronoun follow-up retains the dynamically discovered featured match context.",
      "kind": "featured-follow-up"
    },
    {
      "id": "sse-ordering",
      "description": "Streaming emits grounding before deltas and terminates with done.",
      "kind": "sse",
      "question": "Who is leading the Premier League title race?",
      "expectGrounding": "season",
      "expectCompetitionId": "eng.1"
    },
    {
      "id": "client-cancellation",
      "description": "A disconnected streaming client cancels its request promptly without a transport failure response.",
      "kind": "cancellation",
      "question": "What is the latest injury and availability news for Arsenal?"
    },
    {
      "id": "malformed-history",
      "description": "A dangling conversation-history turn is rejected without model traffic.",
      "kind": "invalid",
      "body": {
        "question": "And what about them?",
        "history": [
          {
            "role": "user",
            "content": "Compare the two teams."
          }
        ]
      },
      "expectStatus": 400
    }
  ]
}
