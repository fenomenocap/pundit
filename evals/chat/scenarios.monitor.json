{
  "schemaVersion": 17,
  "fixed": [
    {
      "id": "active-match-grounding",
      "description": "A model-backed active club fixture receives match grounding and delivers a complete headline win/draw/win line under a section label that is not left empty. A provider-labelled normal end_turn still fails if the answer ends in a numeric or Markdown fragment.",
      "kind": "featured",
      "expectHeadlineOneXTwo": true
    },
    {
      "id": "priced-fixture-retains-1x2-context",
      "description": "An explicit 1X2 follow-up cannot lose or replace the exact priced fixture.",
      "kind": "featured-turns",
      "turns": [
        {
          "questionTemplate": "Analyse {home} vs {away}.",
          "expectGrounding": "match"
        },
        {
          "question": "What will the 1X2 be?",
          "expectGrounding": "match"
        }
      ]
    },
    {
      "id": "analyst-conversation-golden-path",
      "description": "One coherent analyst handles a full preview, exact-score fair price, scorer boundary, lineup counterfactual, table detour and market disagreement without repeating a full report or exposing internal machinery.",
      "kind": "featured-turns",
      "turns": [
        {
          "questionTemplate": "Give me your full preview of {home} vs {away}, including the 1X2, likely scorelines and any comparable market disagreement.",
          "expectGrounding": "match",
          "expectHeadlineOneXTwo": true,
          "expectAnalystVoice": true,
          "expectDirectAnswer": true,
          "expectNoUnsupportedMarketCausality": true,
          "expectComparableMarketAttribution": true
        },
        {
          "question": "What is your fair decimal price for an exact 2-1 score?",
          "expectGrounding": "match",
          "expectAnalystVoice": true,
          "expectDirectAnswer": true,
          "expectNarrowFollowup": true,
          "expectExactScoreFairPrice": "2-1"
        },
        {
          "question": "Who will most likely score for Liverpool?",
          "expectGrounding": "match",
          "allowAbstention": true,
          "expectAnalystVoice": true,
          "expectDirectAnswer": true,
          "expectNarrowFollowup": true,
          "expectCannotReprice": true,
          "expectNoUnsupportedScorerInference": true,
          "expectNoUnsupportedMarketCausality": true
        },
        {
          "question": "If the home striker is ruled out, exactly how many percentage points would you take off the home win?",
          "expectGrounding": "match",
          "allowAbstention": true,
          "expectAnalystVoice": true,
          "expectDirectAnswer": true,
          "expectNarrowFollowup": true,
          "expectCannotReprice": true,
          "expectNoUnsupportedMarketCausality": true,
          "expectNoUnsupportedLineupEffect": true
        },
        {
          "question": "Quick detour: what does the current Premier League table show?",
          "expectGrounding": "competition",
          "expectCompetitionId": "eng.1",
          "expectDirectAnswer": true,
          "expectNarrowFollowup": true,
          "expectTableMatchCountsGrounded": true
        },
        {
          "question": "Back to that match: where do you disagree most with the available 1X2 market, and does the gap prove anything about lineups?",
          "expectGrounding": "match",
          "expectAnalystVoice": true,
          "expectDirectAnswer": true,
          "expectNarrowFollowup": true,
          "expectNoUnsupportedMarketCausality": true,
          "expectComparableMarketAttribution": true
        }
      ]
    },
