# ─── API ────────────────────────────────────────────────────────────────────
API_PORT=3001
API_URL=http://localhost:3001

# Comma-separated browser origins allowed to call the API (CORS).
# Leave empty for open CORS during local debugging. Production should set this
# to the Vercel frontend origin(s), e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# ─── Frontend (Next.js) ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# Set to "false" to switch off mock data and hit the real API
NEXT_PUBLIC_USE_MOCK=true

# External docs (Gitbook or similar). Leave unset to hide "How it works" links in the UI.
NEXT_PUBLIC_DOCS_URL=

# ─── Polymarket (Gamma API is public — no key needed) ──────────────────────
# Reference: https://docs.polymarket.com/#gamma-markets-api

# ─── MiniMax (required for POST /api/ask; configured in Railway prod) ───────
# Never commit or log a real value.
#
# Shared fallback for both inference and search. Everything below is optional
# and only ever overrides one of the two, so an existing deployment that sets
# only this keeps working exactly as before.
MINIMAX_API_KEY=
# Optional. The base URL is region-scoped: a key issued for mainland China
# authenticates only against https://api.minimaxi.com/anthropic.
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimax.io/anthropic

# ─── Inference credential (strongly recommended in production) ──────────────
# An Open Platform pay-as-you-go key, so answering a question no longer spends
# the same quota as searching for evidence -- or as a developer's Claude Code
# session on the same subscription. Falls back to MINIMAX_API_KEY when unset;
# /ready reports `inference.dedicatedKey` so a shared key is never silent.
MINIMAX_INFERENCE_API_KEY=
# Optional: only when the inference key is region-scoped differently from the
# search key. Falls back to MINIMAX_BASE_URL.
MINIMAX_INFERENCE_BASE_URL=

# ─── Web search providers ───────────────────────────────────────────────────
# Search is a provider chain. MiniMax's /v1/coding_plan/search is undocumented
# and subscription-metered, so it is optional; configure at least one more
# provider in production or a throttle there leaves answers with no evidence.
#
# Optional: point search at a key that is not the inference one. Falls back to
# MINIMAX_API_KEY.
MINIMAX_SEARCH_API_KEY=
# Optional override for the undocumented endpoint, should it move.
MINIMAX_SEARCH_URL=
# Brave Search API (https://api-dashboard.search.brave.com). A documented,
# contractual provider with its own quota and status page. Setting this key is
# all that is needed to gain automatic failover.
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_URL=
# Comma-separated chain order. Either provider can be made primary with no code
# change: `brave,minimax` promotes Brave. Unknown names are ignored, and any
# provider not named still trails the chain. Default: minimax,brave
WEB_SEARCH_PROVIDER_ORDER=
# Searches in flight process-wide. A load control, deliberately independent of
# provider health. Default 4, max 8. Two was chosen before anyone measured
# whether the burst was a problem; production has never recorded a throttle, and
# two ran the six searches behind an answer three waves deep on the critical
# path while a reader waited.
WEB_SEARCH_CONCURRENCY=4

# ─── Rate limiting for POST /api/ask ────────────────────────────────────────
# The limit across the whole deployment. express-rate-limit counts per process,
# so the per-instance budget is this divided by API_REPLICAS. Railway runs one
# replica today, so 1 makes the configured limit the real one. /ready reports
# the resolved values.
ASK_RATE_LIMIT_PER_MINUTE=10
API_REPLICAS=1
