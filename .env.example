# ─── Chain config ──────────────────────────────────────────────────────────
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
BLOCK_EXPLORER_URL=https://sepolia.basescan.org

# ─── Contract addresses (filled after deployment) ──────────────────────────
FACTORY_ADDRESS=
ENGINE_ADDRESS=
RESOLVER_ADDRESS=
USDC_ADDRESS=
DEPLOYMENT_BLOCK=0

# ─── Indexer ────────────────────────────────────────────────────────────────
INDEXER_POLL_MS=5000

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/sports_prediction_markets

# ─── API ────────────────────────────────────────────────────────────────────
API_PORT=3001
API_URL=http://localhost:3001

# ─── Admin API key (secret — never expose publicly or prefix NEXT_PUBLIC_) ──
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# ─── Frontend (Next.js) ─────────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Contract addresses mirrored for the frontend
NEXT_PUBLIC_ENGINE_ADDRESS=
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=

# Set to "false" to switch off mock data and hit the real API
NEXT_PUBLIC_USE_MOCK=true

# ─── Polymarket (Gamma API is public — no key needed) ──────────────────────
# Reference: https://docs.polymarket.com/#gamma-markets-api

# ─── Deployer (NEVER commit actual values) ──────────────────────────────────
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
